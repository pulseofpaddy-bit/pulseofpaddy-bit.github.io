{
  "rules": {
    ".read": false,
    ".write": false,

    "households": {
      "$householdId": {
        "members": {
          "$uid": {
            ".read": "auth != null && root.child('households').child($householdId).child('members').child(auth.uid).exists()",
            ".write": "auth != null && auth.uid == $uid && newData.child('email').val() == auth.token.email && ($householdId == auth.token.email.replace('.', ',').replace('#', ',').replace('$', ',').replace('[', ',').replace(']', ',').replace('@', ',') || root.child('member_lookup').child(auth.token.email.replace('.', ',').replace('#', ',').replace('$', ',').replace('[', ',').replace(']', ',').replace('@', ',')).child('headKey').val() == $householdId || (data.exists() && data.child('uid').val() == auth.uid))"
          }
        },
        "health": {
          ".read": "auth != null && (root.child('households').child($householdId).child('members').child(auth.uid).child('gender').val() == 'girl' || (root.child('households').child($householdId).child('members').child(auth.uid).child('gender').val() == 'female' && (root.child('households').child($householdId).child('members').child(auth.uid).child('relation').val() == 'head' || root.child('households').child($householdId).child('members').child(auth.uid).child('relation').val() == 'spouse' || root.child('households').child($householdId).child('members').child(auth.uid).child('relation').val() == 'child' || root.child('households').child($householdId).child('members').child(auth.uid).child('role').val() == 'head')))",
          ".write": "auth != null && (root.child('households').child($householdId).child('members').child(auth.uid).child('gender').val() == 'girl' || (root.child('households').child($householdId).child('members').child(auth.uid).child('gender').val() == 'female' && (root.child('households').child($householdId).child('members').child(auth.uid).child('relation').val() == 'head' || root.child('households').child($householdId).child('members').child(auth.uid).child('relation').val() == 'spouse' || root.child('households').child($householdId).child('members').child(auth.uid).child('relation').val() == 'child' || root.child('households').child($householdId).child('members').child(auth.uid).child('role').val() == 'head')))"
        }
      }
    },

    "family": {
      "$householdId": {
        ".read": "auth != null && root.child('households').child($householdId).child('members').child(auth.uid).exists()",
        ".write": "auth != null && root.child('households').child($householdId).child('members').child(auth.uid).exists()"
      }
    },

    "reservations": {
      "$userKey": {
        ".read": "auth != null && $userKey == auth.token.email.replace('.', ',').replace('#', ',').replace('$', ',').replace('[', ',').replace(']', ',')",
        ".write": "auth != null && $userKey == auth.token.email.replace('.', ',').replace('#', ',').replace('$', ',').replace('[', ',').replace(']', ',')"
      }
    },

    "clothing": {
      "$userKey": {
        ".read": "auth != null && $userKey == auth.token.email.replace('.', ',').replace('#', ',').replace('$', ',').replace('[', ',').replace(']', ',')",
        ".write": "auth != null && $userKey == auth.token.email.replace('.', ',').replace('#', ',').replace('$', ',').replace('[', ',').replace(']', ',')"
      }
    },

    "member_lookup": {
      "$memberKey": {
        ".read": "auth != null && ($memberKey == auth.token.email.replace('.', ',').replace('#', ',').replace('$', ',').replace('[', ',').replace(']', ',').replace('@', ',') || root.child('member_lookup').child($memberKey).child('headKey').val() == auth.token.email.replace('.', ',').replace('#', ',').replace('$', ',').replace('[', ',').replace(']', ',').replace('@', ','))",
        ".write": "auth != null && (newData.child('headKey').val() == auth.token.email.replace('.', ',').replace('#', ',').replace('$', ',').replace('[', ',').replace(']', ',').replace('@', ',') || $memberKey == auth.token.email.replace('.', ',').replace('#', ',').replace('$', ',').replace('[', ',').replace(']', ',').replace('@', ','))"
      }
    }
  }
}
